# Copy to a local .env (gitignored) or export these before running the deploy/verify scripts.
# None of these are secrets — the deployed design uses managed identity, not passwords.

# Azure SQL (used by load_db.py and setup_db_identity.py, via your AAD login)
TPRM_SQL_SERVER=your-sql-server.database.windows.net
TPRM_SQL_DB=tprmdb

# Deployed MCP endpoint (used by smoke_test.py)
MCP_URL=https://your-container-app.region.azurecontainerapps.io/mcp

# Deployed report-viewer base URL (the agent posts the HTML report here; also used by
# deploy/smoke_report.py). No trailing slash.
REPORT_HOST_URL=https://your-report-app.region.azurecontainerapps.io

# Foundry project + agent (used by verify_agent.py)
FOUNDRY_ENDPOINT=https://your-foundry-account.services.ai.azure.com/api/projects/your-project
AGENT_NAME=TPRM-Risk-Assessor
